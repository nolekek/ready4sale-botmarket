# ========================================================
# НАСТРОЙКИ ГОТОВОГО БОТА AUTOSHOP PRO v2.4 (+ MINI APP)
# Переименуйте этот файл в .env и укажите свои данные
# ========================================================

# Токен вашего Telegram-бота (получить у @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram ID администратора (или нескольких через запятую: 123456789,987654321)
ADMIN_IDS=123456789

# Имя магазина, отображаемое в шапке бота и Mini App
SHOP_NAME=🔥 Digital Hub Shop

# Ссылка на службу поддержки / личку администратора (например, @your_username)
SUPPORT_CONTACT=@admin_username

# Ссылка на новостной канал или отзывы магазина (необязательно)
CHANNEL_URL=https://t.me/your_channel

# Валюта магазина по умолчанию (RUB)
SHOP_CURRENCY=RUB

# Процент начисления бонусов рефералу от покупок приглашенного (например, 5 = 5%)
REFERRAL_PERCENT=5

# ========================================================
# НАСТРОЙКИ TELEGRAM MINI APP (TMA)
# ========================================================

# Порт встроенного веб-сервера Mini App (по умолчанию 8080)
WEBAPP_PORT=8080

# Публичный HTTPS адрес вашего Mini App (например, https://myshop.com или ссылка туннеля)
# Если оставить пустым, бот работает в классическом режиме (с возможностью открыть WebApp локально)
WEBAPP_URL=

# ========================================================
# НАСТРОЙКИ ПЛАТЕЖЕЙ (Включайте нужные, остальные оставьте пустыми)
# ========================================================

# 1. Telegram Stars (XTR) — официальная валюта Telegram (1 Star ~ 1.5 - 2 RUB)
ENABLE_STARS=True
STAR_RATE_RUB=2.0

# 2. CryptoBot — оплата криптовалютой (USDT, TON, BTC)
# Токен API приложения CryptoPay (получить в @CryptoBot -> Crypto Pay -> Create App)
CRYPTOBOT_TOKEN=

# 3. Оплата по СБП / на Карту РФ (с отправкой чека администратору)
ENABLE_SBP_MANUAL=True
SBP_REQUISITES=Сбер / Т-Банк: +7 (999) 000-00-00 (Иван И.)
